# ローカル実行用の設定例。cp .env.example .env して使う
TZ=Asia/Tokyo
LATITUDE=34.6937
LONGITUDE=135.5023
PLACE_NAME=大阪
SCREEN_WIDTH=1072
SCREEN_HEIGHT=1448
ORIENTATION=landscape
LANDSCAPE_ROTATE=0
CACHE_SECONDS=0
SHOW_CLAUDE=1
PUSH_TOKEN=
# claude setup-token で作ったトークン。設定するとサーバーが Claude Code で使用量を定期取得する
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_POLL_MINUTES=15
