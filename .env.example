# 設定ファイルの雛形。cp .env.example .env して使う。
# ローカル（uv run --env-file .env）でも Docker（docker compose）でも、この .env を読む。
# 行を消すか # を付けるか値を空にすると、右に書いた既定値になる。

# ---- 場所・時刻 ----
# TZ=Asia/Tokyo
# 天気を取る地点と表示名（既定は大阪市）
# LATITUDE=34.6937
# LONGITUDE=135.5023
# PLACE_NAME=大阪

# ---- 画面 ----
# Kindle Paperwhite 3（第7世代）の画素数。縦横どちらの順で書いてもよい
# SCREEN_WIDTH=1072
# SCREEN_HEIGHT=1448
# landscape（横・既定）か portrait（縦）
# ORIENTATION=landscape
# 横置きのとき、デザインを反時計回りに何度回して出力するか。
# 90（既定）は Kindle の下端（電源ボタン・USB）が左に来る向き。上下が逆なら 270。
# 0 だと横長PNGのままになり、Kindle では右側が切れる（レイアウト確認用）
# LANDSCAPE_ROTATE=90
# 同じ画像を使い回す秒数（ローカルで編集しながら見るなら 0 が便利）
# CACHE_SECONDS=60

# ---- Claude 使用量 ----
# 0 でパネルを隠す
# SHOW_CLAUDE=1
# 設定すると POST /claude-usage に同じ値のトークンが必要になる（PC側は --token か KINDLE_DASH_TOKEN）
PUSH_TOKEN=
# claude setup-token で作ったトークン。設定するとサーバーが Claude Code で使用量を定期取得する
CLAUDE_CODE_OAUTH_TOKEN=
# 上の取得間隔（分）。0 で取得しない
# CLAUDE_POLL_MINUTES=15
# CLAUDE_POLL_MODEL=haiku

# ---- Codex 使用量 ----
# 0 でパネルを隠す
# SHOW_CODEX=1
# Codex のアクセストークン（ChatGPT の Business / Enterprise ワークスペースで発行するもの）。
# 個人プランでは発行できないので、空のままにして
# docker compose exec kindle-dash codex login --device-auth でコンテナ内にログインする
CODEX_ACCESS_TOKEN=
# コンテナ内で取得する間隔（分）。0 で取得しない
# CODEX_POLL_MINUTES=15

# ---- 電車の発車時刻 ----
# 0 でパネルを隠す
# SHOW_TRAIN=1
# TRAIN_LABEL=岡町 → 大阪梅田
# 阪急の駅時刻表ページ。{day} が w（平日）/ h（土曜・休日）に置き換わる
# TRAIN_TIMETABLE_URL=https://www.hankyu.co.jp/station/html/HK-45_ta_1_{day}.html
# TRAIN_WINDOW_MINUTES=30

# ---- 保存先 ----
# 使用量と時刻表の保存先。Docker では ./data を /srv/data にマウントしている
# DATA_DIR=data
